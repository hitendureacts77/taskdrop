// Cloudflare Worker for the PRODUCTION user web app (plan task 5.12): static files only, no code.
// `node scripts/cloudflare-web-build.mjs --target production` builds apps/mobile/dist and writes its _headers file;
// `npx wrangler deploy --config wrangler.production.jsonc` uploads it (needs CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskdrop-production",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/mobile/dist",
    // Any path that is not a file (a deep link such as /explore) gets /index.html with status 200, like the Vercel rewrite did.
    "not_found_handling": "single-page-application"
  }
}
