  "cards": [
    { "dot": "emerald", "title": "Why an outbox", "items": ["The row is written in the same transaction as the change, so an event is never lost or invented", "A rolled-back change never reaches Inngest: pg_net posts only after commit", "emit_event swallows its own errors, so it can never break the action that fired it"] },
    { "dot": "amber", "title": "Safety net", "items": ["If the fast push fails, the sweeper re-sends unsent rows every 5 minutes", "The outbox id is the Inngest event id, so a second send is dropped as a duplicate"] },
    { "dot": "rose", "title": "What leaves the database", "items": ["Ids, names, amounts and fixed categories only", "Never phone numbers, emails, bank details, or text a person typed"] }
  ]
