  "cards": [
    {
      "dot": "cyan",
      "title": "Who gets in",
      "items": [
        "Google or @username + password; the account must hold the admin role",
        "ADMIN_EMAIL / ADMIN_PHONE can add an allowlist on top",
        "Idle limit 30 min and absolute limit 12 h, checked on every request"
      ]
    },
    {
      "dot": "rose",
      "title": "Who may do what",
      "items": [
        "Staff role (admin, finance, support, sales, viewer) narrows each area",
        "Money actions also need a verified authenticator code (aal2)",
        "The database repeats both checks; the panel checks first to explain"
      ]
    },
    {
      "dot": "amber",
      "title": "Shared with the app",
      "items": [
        "One Supabase project: what staff change is the live app's data",
        "Switches reach the app through app-config; api enforces them",
        "The service-role key never reaches the browser"
      ]
    }
  ]
