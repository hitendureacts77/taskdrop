  "cards": [
    {
      "dot": "cyan",
      "title": "How to read it",
      "items": [
        "Key columns only; the full column list is in packages/db-types",
        "Every user id is the auth.users id; profiles.id is the same value",
        "Money columns end in _minor and count paise"
      ]
    },
    {
      "dot": "amber",
      "title": "Money columns",
      "items": [
        "tasks.locked_minor is the chosen price; assignments.escrow_minor adds the poster fee",
        "wallets keeps balance, clearing (7-day hold) and credits apart",
        "payments are money in (escrow, top-up); payouts are money out"
      ]
    },
    {
      "dot": "rose",
      "title": "Not shown",
      "items": [
        "Support, disputes, notifications, reports, settings, app controls",
        "private.outbox and admin_alerts (see the architecture diagram)",
        "Admin-only tables used by the separate admin panel"
      ]
    }
  ]
