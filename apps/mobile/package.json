{
  "name": "@taskdrop/mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/web.mjs",
    "web:export": "expo export -p web --source-maps && node scripts/web-env-guard.mjs",
    "typecheck": "tsc --noEmit",
    "build:apk": "npx eas-cli build --platform android --profile preview",
    "build:staging-apk": "npx eas-cli build --platform android --profile staging-apk",
    "build:play-testing": "npx eas-cli build --platform android --profile staging-store",
    "build:production-apk": "npx eas-cli build --platform android --profile production-apk",
    "build:store": "npx eas-cli build --platform android --profile production",
    "build:guard": "node scripts/build-guard.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@firebase/app": "^0.16.2",
    "@firebase/app-check": "^0.13.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/app-check": "27.1.0",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.118.0",
    "@taskdrop/db-types": "*",
    "@taskdrop/rules": "*",
    "@taskdrop/schemas": "*",
    "@taskdrop/supabase": "*",
    "babel-preset-expo": "~58.0.20",
    "expo": "~58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.20",
    "expo-web-browser": "~58.0.7",
    "maplibre-gl": "5.24.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
