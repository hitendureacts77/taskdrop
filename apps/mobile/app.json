{
  "expo": {
    "name": "TaskDrop",
    "slug": "taskdrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "taskdrop",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E8F72",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.taskdrop.app",
      "versionCode": 1,
      "usesCleartextTraffic": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "TaskDrop",
      "shortName": "TaskDrop",
      "description": "Ask for anything. Someone gets it done.",
      "lang": "en",
      "themeColor": "#0E8F72",
      "backgroundColor": "#0F1012",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskDrop uses your photos so you can show a worker the job before they quote.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TaskDrop uses your location to show jobs near you and to set where a job is.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0E8F72"
        }
      ]
    ]
  }
}
