# ---- Supabase (shared by web + mobile) ----
# Public (safe to ship in clients)
EXPO_PUBLIC_SUPABASE_URL=https://wjxvingpfbfvkfqhrguj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here
NEXT_PUBLIC_SUPABASE_URL=https://wjxvingpfbfvkfqhrguj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# Server-only (NEVER expose to clients — Edge Functions / server actions)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- Razorpay (server-only, used from Edge Functions) ----
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---- Maps (optional, client-side) ----
# Place search works without this: it falls back to OpenStreetMap's Nominatim,
# which needs no key and returns real coordinates. Set a key to use Google
# Places instead, which gives better results for Indian addresses.
#
# Restrict the key to the Places API and to your app's origins before shipping
# it — anything with EXPO_PUBLIC_ is visible in the client bundle.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Copyright agent (public, shown on the in-app Copyright page) ----
# The DMCA designated agent, exactly as registered at
# https://www.copyright.gov/dmca-directory/ (a person has to file that, ~$6).
# Until these are set, the page explains the rules but cannot send a notice.
EXPO_PUBLIC_COPYRIGHT_AGENT_NAME=
EXPO_PUBLIC_COPYRIGHT_AGENT_EMAIL=
EXPO_PUBLIC_COPYRIGHT_AGENT_ADDRESS=
EXPO_PUBLIC_COPYRIGHT_AGENT_PHONE=

# ---- Crash reporting (public) ----
# A Sentry project's DSN (sentry.io -> Project -> Settings -> Client Keys).
# Designed to be public: it can only send events. Empty = nothing is sent.
# The api Edge Function reports its own errors with SENTRY_DSN, set as a
# function secret or in Vault (can be the same DSN).
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only, NOT public: lets native builds upload source maps and debug
# symbols to Sentry (org "hitendu", project "taskdrop"). Put it in
# apps/mobile/.env.local on your machine and in EAS secrets for EAS builds
# (`eas secret:create --name SENTRY_AUTH_TOKEN`). Never use an EXPO_PUBLIC_ name.
SENTRY_AUTH_TOKEN=

# ---- Legal (public, shown in the Terms, Privacy Policy and grievance contact) ----
# Until these are set the pages fall back to "TaskDrop" and "Help & support".
EXPO_PUBLIC_LEGAL_ENTITY=
EXPO_PUBLIC_LEGAL_ADDRESS=
EXPO_PUBLIC_LEGAL_EMAIL=
# India's IT Rules 2021 require a named Grievance Officer with contact details.
EXPO_PUBLIC_GRIEVANCE_OFFICER_NAME=
EXPO_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
# City whose courts hear disputes about the Terms, e.g. Hyderabad.
EXPO_PUBLIC_LEGAL_JURISDICTION=
# Set to yes once a lawyer has approved the Terms and Privacy Policy text;
# until then both pages carry a "Draft -- under legal review" note.
EXPO_PUBLIC_LEGAL_REVIEWED=

# ---- Inngest (background jobs) ----
# Server-only. These are Edge Function secrets, not app variables:
#   supabase secrets set INNGEST_SIGNING_KEY=... INNGEST_EVENT_KEY=...
# Signing key verifies that calls to the inngest function really come from Inngest;
# the event key lets the function send events. Both are in the Inngest dashboard.
# The database gets the event address separately, as the Vault secret
# `inngest_event_url` (see docs/INNGEST.md). INNGEST_MONEY_JOBS=on moves the three
# money sweeps off pg_cron; leave it unset until the cutover.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_MONEY_JOBS=

# ---- ImageKit (pictures) ----
# Server-only. Edge Function secrets (or Vault), not app variables:
#   supabase secrets set IMAGEKIT_PUBLIC_KEY=... IMAGEKIT_PRIVATE_KEY=... \
#     IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your id> IMAGEKIT_ENV=local
# Keys: ImageKit dashboard -> Developer options -> API keys. The private key
# signs uploads and picture URLs and must never be in the app, a commit or a chat.
# IMAGEKIT_ENV is the top folder for this deployment: local, beta or prod.
# While any of the first three is unset, pictures keep going to Supabase Storage.
# See docs/MEDIA.md.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_ENV=

# ---- Where the app is served (public) ----
# The address a shared task link points at. Native builds cannot know it on their own.
# Test deployment: https://taskdrop.in (the web build reads the origin it is served from if this is empty).
EXPO_PUBLIC_APP_URL=
# Which environment events are filed under in Sentry (beta, production). EAS sets it per build profile.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=

# ---- Project and deploy scripts (server/PC only, never in the app) ----
# The one Supabase project (test environment, shared with the old app until Phase 9).
SUPABASE_PROJECT_ID=wjxvingpfbfvkfqhrguj
# The test project's Session pooler connection string, password included (Supabase dashboard ->
# Connect). Used by `npm run seed:reset`, `npm run deploy:migrations` and the database checks in
# docs/DEPLOY.md. The same value is the GitHub secret TEST_DATABASE_URL. Never commit it.
DATABASE_URL=
# A personal access token (supabase.com -> Account -> Access Tokens): deploys Edge Functions and
# lets scripts/add-redirect-urls.mjs change the sign-in redirect list. GitHub secret of the same name.
SUPABASE_ACCESS_TOKEN=
# EAS Update from CI (Phase 1); GitHub secret EXPO_TOKEN.
EXPO_TOKEN=

# ---- Edge Function secrets (set with `supabase secrets set NAME=value`, never in the app) ----
# Listed so nothing is forgotten; the full inventory is Part B, section 7 of docs/UPGRADE_PLAN.md.
#   RAZORPAYX_KEY_ID, RAZORPAYX_KEY_SECRET, RAZORPAYX_ACCOUNT_NUMBER, RAZORPAYX_WEBHOOK_SECRET
#                        payouts (scripts/push-payment-secrets.sh sets them with the Razorpay ones)
#   MSG91_AUTHKEY, MSG91_TEMPLATE_ID   real OTP texts; while empty, phone-auth uses the test codes
#   TEST_PHONES          comma-separated 10-digit numbers that skip SMS (the seed accounts)
#   ALLOW_ANY_OTP        "1" arms the fixed code 000000 for every number. Test project only, never set with MSG91
#   GOOGLE_MAPS_API_KEY  server key for places-search (separate from the restricted Android key above)
#   SENTRY_DSN, SENTRY_ENVIRONMENT      errors from the functions
#   API_GATEWAY_SECRET   also in Supabase Vault (migration 083); the admin app needs the same value
#   INNGEST_DEV, INNGEST_PUSH_RECEIPT_WAIT   optional tuning for the inngest function
