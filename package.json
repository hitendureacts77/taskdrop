{
  "name": "taskdrop",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.8",
  "description": "TaskDrop — reverse-marketplace (Expo mobile + Next.js web + Supabase). Monorepo.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run web --workspace @taskdrop/mobile",
    "web": "npm run web --workspace @taskdrop/mobile",
    "android": "npm run start --workspace @taskdrop/mobile",
    "web:export": "npm run web:export --workspace @taskdrop/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/run-unit-tests.mjs",
    "db:types": "node scripts/gen-db-types.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:contract": "node --experimental-transform-types --no-warnings supabase/functions/api/contract.test.ts",
    "test:seed": "node scripts/reset-test-data.mjs --local",
    "seed:reset": "node scripts/reset-test-data.mjs",
    "deploy:migrations": "node scripts/deploy-migrations.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "legal:export": "node scripts/export-legal.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:payments": "node scripts/check-payments.mjs",
    "payouts": "node scripts/payouts.mjs",
    "test:e2e": "playwright test",
    "e2e:clear-notifications": "node scripts/clear-e2e-notifications.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "secret-guard": "node scripts/secret-guard.mjs --all",
    "check:exposed": "node scripts/check-exposed-files.mjs",
    "check:gateway": "node scripts/check-gateway-only.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:apk": "node scripts/check-apk.mjs",
    "security:history": "node scripts/secret-history.mjs",
    "security:storage": "node scripts/security-storage.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "pg": "^8.23.1",
    "turbo": "^2.11.10",
    "typescript": "^5.6.2",
    "wrangler": "4.168.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
