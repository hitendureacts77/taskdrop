{
  "name": "taskdrop",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.8",
  "description": "TaskDrop — reverse-marketplace (Expo mobile + Next.js web + Supabase). Monorepo.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run web --workspace @taskdrop/mobile",
    "web": "npm run web --workspace @taskdrop/mobile",
    "android": "npm run start --workspace @taskdrop/mobile",
    "web:export": "npm run web:export --workspace @taskdrop/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --experimental-strip-types --test packages/rules/src/rules.test.ts packages/schemas/src/schemas.test.ts",
    "db:types": "supabase gen types typescript --project-id wjxvingpfbfvkfqhrguj --schema public > packages/db-types/src/database.types.ts",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/money_rules.test.sql",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
