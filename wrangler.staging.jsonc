// Cloudflare Worker for the STAGING user web app (plan task 5.12): static files only, no code.
// `node scripts/cloudflare-web-build.mjs --target staging` builds apps/mobile/dist and writes its _headers file;
// `npx wrangler deploy --config wrangler.staging.jsonc` uploads it (needs CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskdrop-staging",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/mobile/dist",
    // Plan 3.6 (T13 #8): every address the site answers is a file (index.html, terms.html, privacy.html, support.html,
    // copyright.html, get.html: apps/mobile/scripts/web-route-pages.mjs), so any other path gets 404.html with status 404.
    // 404.html is the same app, which shows its "Page not found" screen (src/components/NotFound.tsx).
    "not_found_handling": "404-page"
  }
}
